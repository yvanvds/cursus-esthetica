---
/**
 * Pagina 37 — de eigen layout van hoofdstuk 17, "Voor wie schrijf je je
 * naam?" (graffiti-en-street-art). De pagina als de krantenpagina van 21 juli
 * 1971: masthead, dubbele lijn, datumregel, en daaronder de kop als
 * broadsheet-kop (de h1 staat in de MDX-body; de stylesheet van het hoofdstuk
 * geeft hem zijn vorm).
 *
 * Dit is de vorm van niveau 3 (BRIEFING §5): een layout die ThemeLayout
 * OMHULT, niet vervangt. ThemeLayout levert het grid, de sidebar, de TOC, de
 * dialogs, de scripts en de prose-regels; de hoofdstukkop ervan (broodkruimel
 * plus leestijd) is de standaardinhoud van zijn slot `header`, en deze layout
 * vult die slot met de masthead. Alles wat ThemeLayout aan props verwacht gaat
 * ongewijzigd door, de default slot ook. Een volledig eigen HTML-structuur
 * zou elk van die onderdelen opnieuw moeten bouwen, en bij elke wijziging aan
 * ThemeLayout achterlopen; een kop vervangen is wat niveau 3 in de praktijk
 * vraagt. `[theme].astro` kiest deze layout op `customLayout: "Pagina37"`.
 *
 * Hoofdstuk-specifiek: de datumregel en "pagina 37" horen bij dit ene
 * hoofdstuk en staan hier hardgecodeerd; module, hoofdstuknummer en leestijd
 * komen uit de collectie en de props, zoals in ThemeLayout.
 */
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import ThemeLayout from '../ThemeLayout.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  theme: CollectionEntry<'themes'>;
  headings: Heading[];
  readingTime?: string;
}

const { theme, headings, readingTime } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const allModules = await getCollection('modules');
const allThemes = await getCollection('themes');
const currentModule = allModules.find(m => m.id === theme.data.module);
if (!currentModule) throw new Error(`Module '${theme.data.module}' not found for theme '${theme.id}'`);
const totalInModule = allThemes.filter(t => t.data.module === theme.data.module).length;

// De krant van dit hoofdstuk: de drie plaatsen en jaren van de drie verhalen
// (TAKI 183, de Bienal van São Paulo, de Oatly-campagne), en de pagina waarop
// The New York Times het artikel drukte.
const dateline = 'New York, 21 juli 1971 — São Paulo, 2008 — Parijs, 2023';
const page = 'pagina 37';
---

<ThemeLayout theme={theme} headings={headings} readingTime={readingTime}>
  <header slot="header" class="masthead">
    <p class="masthead__paper">Cursus Esthetica</p>
    <div class="masthead__rule" aria-hidden="true"></div>
    <p class="masthead__dateline">
      <span>{dateline}</span>
      <span>{page}</span>
    </p>
    <p class="masthead__meta">
      <span>
        <a href={`${base}/#${currentModule.id}`}>{currentModule.data.title}</a>
        <span aria-hidden="true">·</span>
        <span>hoofdstuk {theme.data.figure}</span>
        <span aria-hidden="true">·</span>
        <span>{theme.data.order} van {totalInModule}</span>
      </span>
      {readingTime && <span>{readingTime}</span>}
    </p>
  </header>
  <slot />
</ThemeLayout>

<style>
  /* De fonts en kleuren (--font-serif = Playfair Display, --font-mono =
     Courier Prime, --color-rule) staan in src/styles/themes/
     graffiti-en-street-art.css onder html[data-theme]; deze layout rendert
     alleen voor dat hoofdstuk. */
  .masthead {
    margin-bottom: var(--space-lg);
  }

  .masthead__paper {
    font-family: var(--font-serif);
    font-weight: 900;
    font-size: var(--step-3);
    line-height: 1.1;
    letter-spacing: 0.02em;
    color: var(--color-text);
    margin: 0;
    max-width: none;
  }

  /* De dubbele krantenlijn: dik boven, dun onder (.rule in het deck). */
  .masthead__rule {
    box-sizing: border-box;
    height: 7px;
    border-top: 2.5px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
    margin: 0.3rem 0 0.4rem;
  }

  .masthead__dateline,
  .masthead__meta {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.35em var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
    line-height: 1.5;
    margin: 0;
    max-width: none;
  }

  /* 0.1em: zo past de datumregel plus "pagina 37" op één regel in de kolom
     van 68ch (Courier Prime loopt 0.6em per teken). Waar hij toch wrapt
     (tablet, mobiel) houdt `margin-left: auto` de pagina rechts. */
  .masthead__dateline {
    letter-spacing: 0.1em;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-rule);
    padding-bottom: 0.3rem;
  }

  .masthead__dateline > span:last-child,
  .masthead__meta > span:last-child {
    margin-left: auto;
  }

  .masthead__meta {
    letter-spacing: 0.12em;
    color: var(--color-text-dim);
    margin-top: 0.45rem;
  }

  .masthead__meta > span:first-child {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
  }

  .masthead__meta a {
    color: inherit;
    text-decoration: none;
    transition: color var(--transition-color);
  }

  .masthead__meta a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .masthead__paper {
      font-size: var(--step-2);
    }

    .masthead__dateline,
    .masthead__meta {
      letter-spacing: 0.1em;
    }
  }
</style>
